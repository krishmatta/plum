from __future__ import annotations

from plum import Experiment, sweep

from ..registries import EXPERIMENTS


@EXPERIMENTS.register
class Demo(Experiment):
    id = "demo"

    class Params(Experiment.Params):
        base: int = 3

    def _run(self, runner, params):
        # a sweep: one run per param combo, with a run id derived from the params
        for combo, run_id in sweep(
            {"n": [params.base, params.base + 2]},
            run_id=lambda p: f"demo-{p['n']}",
        ):
            runner.run("load", run_id, n=combo["n"], description=f"demo n={combo['n']}")
