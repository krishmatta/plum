from __future__ import annotations

from plum import autodiscover, build_cli

from . import experiments, pipelines
from .catalog import CATALOG
from .registries import EXPERIMENTS, PIPELINES

# imports every module in pipelines/ and experiments/, running their registrations
autodiscover(pipelines)
autodiscover(experiments)

app = build_cli(catalog=CATALOG, pipelines=PIPELINES, experiments=EXPERIMENTS)

if __name__ == "__main__":
    app()
